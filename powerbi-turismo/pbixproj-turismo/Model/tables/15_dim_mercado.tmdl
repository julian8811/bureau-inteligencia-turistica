table '15_dim_mercado'

	column mercado
		dataType: string
		summarizeBy: none
		sourceColumn: mercado

	column tipo
		dataType: string
		summarizeBy: none
		sourceColumn: tipo

	partition '15_dim_mercado' = m
		mode: import
		source =
				let
				        Source = #table(
				            {"mercado","tipo"},
				            {
				      {"Global","Global"},
				      {"Europa-Am-AsiaPac","Regional"},
				      {"Medio Oriente","Regional"},
				      {"31 mercados Europa","Panel"},
				      {"Cadenas globales","Cadena"}
				            }
				        ),
				        Typed = Table.TransformColumnTypes(Source, {{"mercado", type text},{"tipo", type text}})
				    in
				        Typed

	annotation PBI_ResultType = Table
