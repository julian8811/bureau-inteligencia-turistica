table '05_fact_eurostat_noches'

	column periodo
		dataType: string
		summarizeBy: none
		sourceColumn: periodo

	column noches_M
		dataType: double
		summarizeBy: sum
		sourceColumn: noches_M

	column var_M
		dataType: double
		summarizeBy: sum
		sourceColumn: var_M

	column var_pct
		dataType: double
		summarizeBy: average
		sourceColumn: var_pct

	column origen
		dataType: string
		summarizeBy: none
		sourceColumn: origen

	column fuente
		dataType: string
		summarizeBy: none
		sourceColumn: fuente

	column id_fuente
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: id_fuente

	measure 'Noches M' = SUM('05_fact_eurostat_noches'[noches_M])
		formatString: #,##0

	measure 'Noches Intl Share %' = DIVIDE(CALCULATE(SUM('05_fact_eurostat_noches'[noches_M]),'05_fact_eurostat_noches'[origen]="Internacional"),CALCULATE(SUM('05_fact_eurostat_noches'[noches_M]),ALL('05_fact_eurostat_noches'[origen])))
		formatString: 0.0%

	measure 'Noches H1 2026 M' = CALCULATE(SUM('05_fact_eurostat_noches'[noches_M]),'05_fact_eurostat_noches'[periodo]="H1 2026")
		formatString: #,##0

	partition '05_fact_eurostat_noches' = m
		mode: import
		source =
				let
				        Source = #table(
				            {"periodo","noches_M","var_M","var_pct","origen","fuente","id_fuente"},
				            {
				      {"H1 2025",1279,null,null,"Total","Eurostat 25/09/2025","EURO-25"},
				      {"2025 est",3080,61.5,2.0,"Total","Eurostat 16/01/2026","EURO-25"},
				      {"2025 consol",3100,null,4.1,"Total","Eurostat 16/10/2026","EURO-25"},
				      {"Q2 2026",849.8,9.9,1.2,"Total","Eurostat ago-2026","EURO-26"},
				      {"Q2 2026 intl",425.4,7.5,1.8,"Internacional","Eurostat ago-2026","EURO-26"},
				      {"Q2 2026 dom",424.4,2.4,0.6,"Domestico","Eurostat ago-2026","EURO-26"},
				      {"H1 2026",1300,21.8,1.7,"Total record","Eurostat ago-2026","EURO-26"},
				      {"H1 2026 intl",645.4,16.0,2.5,"Internacional","Eurostat ago-2026","EURO-26"},
				      {"H1 2026 dom",675.7,5.8,0.9,"Domestico","Eurostat ago-2026","EURO-26"}
				            }
				        ),
				        Typed = Table.TransformColumnTypes(Source, {{"periodo", type text},{"noches_M", type number},{"var_M", type number},{"var_pct", type number},{"origen", type text},{"fuente", type text},{"id_fuente", type text}})
				    in
				        Typed

	annotation PBI_ResultType = Table
