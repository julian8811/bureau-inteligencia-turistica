table '16_dim_segmento'

	column segmento
		dataType: string
		summarizeBy: none
		sourceColumn: segmento

	partition '16_dim_segmento' = m
		mode: import
		source =
				let
				        Source = #table(
				            {"segmento"},
				            {
				      {"Visitantes"},
				      {"Edad"},
				      {"Genero"},
				      {"Destino"},
				      {"Divisas"}
				            }
				        ),
				        Typed = Table.TransformColumnTypes(Source, {{"segmento", type text}})
				    in
				        Typed

	annotation PBI_ResultType = Table
