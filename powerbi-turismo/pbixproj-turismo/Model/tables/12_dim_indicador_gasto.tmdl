table '12_dim_indicador_gasto'

	column indicador
		dataType: string
		summarizeBy: none
		sourceColumn: indicador

	column categoria
		dataType: string
		summarizeBy: none
		sourceColumn: categoria

	partition '12_dim_indicador_gasto' = m
		mode: import
		source =
				let
				        Source = #table(
				            {"indicador","categoria"},
				            {
				      {"Receipts","Ingresos"},
				      {"Export total","Ingresos"},
				      {"WTTC PIB","Impacto"},
				      {"WTTC PIB forecast","Impacto"},
				      {"Phocuswright bookings","Mercado"}
				            }
				        ),
				        Typed = Table.TransformColumnTypes(Source, {{"indicador", type text},{"categoria", type text}})
				    in
				        Typed

	annotation PBI_ResultType = Table
