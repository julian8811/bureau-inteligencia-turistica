table '11_dim_periodo'

	column periodo
		dataType: string
		summarizeBy: none
		sourceColumn: periodo

	column anio
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: anio

	column tipo_periodo
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_periodo

	partition '11_dim_periodo' = m
		mode: import
		source =
				let
				        Source = #table(
				            {"periodo","anio","tipo_periodo"},
				            {
				      {"2023 anual",2023,"Anual"},
				      {"2024 anual",2024,"Anual"},
				      {"2025 anual",2025,"Anual"},
				      {"Q1 2025",2025,"Trimestre"},
				      {"Q1 2026",2026,"Trimestre"},
				      {"Q2 2026",2026,"Trimestre"},
				      {"H1 2025",2025,"Semestre"},
				      {"H1 2026",2026,"Semestre"}
				            }
				        ),
				        Typed = Table.TransformColumnTypes(Source, {{"periodo", type text},{"anio", Int64.Type},{"tipo_periodo", type text}})
				    in
				        Typed

	annotation PBI_ResultType = Table
