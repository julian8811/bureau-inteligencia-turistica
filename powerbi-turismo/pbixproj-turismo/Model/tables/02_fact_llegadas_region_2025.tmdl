table '02_fact_llegadas_region_2025'

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column llegadas_M_2025
		dataType: double
		summarizeBy: sum
		sourceColumn: llegadas_M_2025

	column var_vs_2024_pct
		dataType: double
		summarizeBy: average
		sourceColumn: var_vs_2024_pct

	column var_vs_2019_pct
		dataType: double
		summarizeBy: average
		sourceColumn: var_vs_2019_pct

	column fuente
		dataType: string
		summarizeBy: none
		sourceColumn: fuente

	column id_fuente
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: id_fuente

	measure 'Llegadas Region 2025 M' = SUM('02_fact_llegadas_region_2025'[llegadas_M_2025])
		formatString: #,##0

	measure 'Share Region 2025 %' = DIVIDE(SUM('02_fact_llegadas_region_2025'[llegadas_M_2025]),CALCULATE(SUM('02_fact_llegadas_region_2025'[llegadas_M_2025]),ALL('02_fact_llegadas_region_2025'[region])))
		formatString: 0.0%

	partition '02_fact_llegadas_region_2025' = m
		mode: import
		source =
				let
				        Source = #table(
				            {"region","llegadas_M_2025","var_vs_2024_pct","var_vs_2019_pct","fuente","id_fuente"},
				            {
				      {"Europa",793,4,6,"UN Tourism 20/01/2026","UN-2025"},
				      {"Asia-Pacifico",331,6,-9,"UN Tourism 20/01/2026","UN-2025"},
				      {"Americas",218,1,null,"UN Tourism 20/01/2026","UN-2025"},
				      {"Medio Oriente",100,3,39,"UN Tourism 20/01/2026","UN-2025"},
				      {"Africa",81,8,null,"UN Tourism 20/01/2026","UN-2025"}
				            }
				        ),
				        Typed = Table.TransformColumnTypes(Source, {{"region", type text},{"llegadas_M_2025", type number},{"var_vs_2024_pct", type number},{"var_vs_2019_pct", type number},{"fuente", type text},{"id_fuente", type text}})
				    in
				        Typed

	annotation PBI_ResultType = Table
