table '14_dim_indicador_aereo'

	column indicador
		dataType: string
		summarizeBy: none
		sourceColumn: indicador

	column unidad
		dataType: string
		summarizeBy: none
		sourceColumn: unidad

	column categoria
		dataType: string
		summarizeBy: none
		sourceColumn: categoria

	partition '14_dim_indicador_aereo' = m
		mode: import
		source =
				let
				        Source = #table(
				            {"indicador","unidad","categoria"},
				            {
				      {"Pax segmento","M","Volumen"},
				      {"Premium intl","M","Premium"},
				      {"RPK Q2","% YoY","Variación"},
				      {"RPK Jul total","% YoY","Variación"},
				      {"RPK Jul intl","% YoY","Variación"},
				      {"RPK Jul dom","% YoY","Variación"},
				      {"ASK Ago","% YoY","Capacidad"},
				      {"PLF Ago","%","Ocupación"},
				      {"RPK forecast","% YoY","Pronóstico"}
				            }
				        ),
				        Typed = Table.TransformColumnTypes(Source, {{"indicador", type text},{"unidad", type text},{"categoria", type text}})
				    in
				        Typed

	annotation PBI_ResultType = Table
