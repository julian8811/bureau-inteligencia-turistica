table '04_fact_gasto'

	column indicador
		dataType: string
		summarizeBy: none
		sourceColumn: indicador

	column anio
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: anio

	column valor_USD_T
		dataType: double
		summarizeBy: sum
		sourceColumn: valor_USD_T

	column var_pct
		dataType: double
		summarizeBy: average
		sourceColumn: var_pct

	column detalle
		dataType: string
		summarizeBy: none
		sourceColumn: detalle

	column fuente
		dataType: string
		summarizeBy: none
		sourceColumn: fuente

	column id_fuente
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: id_fuente

	measure 'Receipts 2025 T' = CALCULATE(SUM('04_fact_gasto'[valor_USD_T]),'04_fact_gasto'[indicador]="Receipts",'04_fact_gasto'[anio]=2025)
		formatString: $#,##0.00

	measure 'WTTC 2026F T' = CALCULATE(SUM('04_fact_gasto'[valor_USD_T]),'04_fact_gasto'[indicador]="WTTC PIB forecast")
		formatString: $#,##0.00

	measure 'Export Total 2025 T' = CALCULATE(SUM('04_fact_gasto'[valor_USD_T]),'04_fact_gasto'[indicador]="Export total",'04_fact_gasto'[anio]=2025)
		formatString: $#,##0.00

	partition '04_fact_gasto' = m
		mode: import
		source =
				let
				        Source = #table(
				            {"indicador","anio","valor_USD_T","var_pct","detalle","fuente","id_fuente"},
				            {
				      {"Receipts",2024,1.81,null,"Estimado desde +5% 2025","UN Tourism","UN-2025"},
				      {"Receipts",2025,1.9,5,"Record","UN Tourism 20/01/2026","UN-2025"},
				      {"Export total",2025,2.2,null,"Receipts + transporte","UN Tourism 20/01/2026","UN-2025"},
				      {"WTTC PIB",2025,11.6,4.1,"9,8% PIB, 366M empleos","WTTC 12/05/2026","WTTC-26"},
				      {"WTTC PIB forecast",2026,12.0,3.2,"9,9% PIB","WTTC 12/05/2026","WTTC-26"},
				      {"Phocuswright bookings",2026,1.67,null,"Gross bookings","Phocuswright 10/12/2025","PHO-26"}
				            }
				        ),
				        Typed = Table.TransformColumnTypes(Source, {{"indicador", type text},{"anio", Int64.Type},{"valor_USD_T", type number},{"var_pct", type number},{"detalle", type text},{"fuente", type text},{"id_fuente", type text}})
				    in
				        Typed

	annotation PBI_ResultType = Table
