				        Typed = Table.TransformColumnTypes(Source, {{"segmento", type text},{"categoria", type text},{"valor", type number},{"var_pct", type number},{"fuente", type text},{"id_fuente", type text}})
				    in
				        Typed

	annotation PBI_ResultType = Table
