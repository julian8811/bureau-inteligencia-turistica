table '08_fact_colombia_Q1_2026'

	column segmento
		dataType: string
		summarizeBy: none
		sourceColumn: segmento

	column categoria
		dataType: string
		summarizeBy: none
		sourceColumn: categoria

	column valor
		dataType: double
		summarizeBy: sum
		sourceColumn: valor

	column var_pct
		dataType: double
		summarizeBy: average
		sourceColumn: var_pct

	column fuente
		dataType: string
		summarizeBy: none
		sourceColumn: fuente

	column id_fuente
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: id_fuente

	measure 'Visitantes CO Q1 M' = CALCULATE(SUM('08_fact_colombia_Q1_2026'[valor]),'08_fact_colombia_Q1_2026'[categoria]="Extranjeros Q1 (M)")
		formatString: #,##0.00

	measure 'Share Joven CO %' = CALCULATE(SUM('08_fact_colombia_Q1_2026'[valor]),'08_fact_colombia_Q1_2026'[categoria]="18-49 share")/100
		formatString: 0.0%

	measure 'Mujeres CO Share %' = CALCULATE(SUM('08_fact_colombia_Q1_2026'[valor]),'08_fact_colombia_Q1_2026'[categoria]="Mujeres share")/100
		formatString: 0.0%

	measure 'Bogota Share %' = CALCULATE(SUM('08_fact_colombia_Q1_2026'[valor]),'08_fact_colombia_Q1_2026'[categoria]="Bogota")/100
		formatString: 0.0%

	measure 'Divisas Q1 USD M' = CALCULATE(SUM('08_fact_colombia_Q1_2026'[valor]),'08_fact_colombia_Q1_2026'[categoria]="Q1 USD M")
		formatString: #,##0

	partition '08_fact_colombia_Q1_2026' = m
		mode: import
		source =
				let
				        Source = #table(
				            {"segmento","categoria","valor","var_pct","fuente","id_fuente"},
				            {
				      {"Visitantes","Extranjeros Q1 (M)",1.36,4.4,"Migracion via ANATO","ANATO-26"},
				      {"Visitantes","No residentes Q1 (M)",1.584,null,"Migracion via ANATO","ANATO-26"},
				      {"Edad","18-29 share",21.2,9.2,"ANATO Q1 2026","ANATO-26"},
				      {"Edad","30-39 share",25.6,null,"ANATO Q1 2026","ANATO-26"},
				      {"Edad","40-49 share",18.4,null,"ANATO Q1 2026","ANATO-26"},
				      {"Edad","18-49 share",65.2,null,"ANATO Q1 2026","ANATO-26"},
				      {"Edad","0-17 crec",null,10.4,"ANATO Q1 2026","ANATO-26"},
				      {"Genero","Mujeres share",46.4,6.2,"ANATO Q1 2026","ANATO-26"},
				      {"Genero","Hombres share",53.6,2.9,"ANATO Q1 2026","ANATO-26"},
				      {"Destino","Bogota",35.5,null,"ANATO Q1 2026","ANATO-26"},
				      {"Destino","Antioquia",24.0,null,"ANATO Q1 2026","ANATO-26"},
				      {"Destino","Bolivar",20.0,null,"ANATO Q1 2026","ANATO-26"},
				      {"Divisas","Q1 USD M",3146,9.4,"ANATO Q1 2026","ANATO-26"}
				            }
