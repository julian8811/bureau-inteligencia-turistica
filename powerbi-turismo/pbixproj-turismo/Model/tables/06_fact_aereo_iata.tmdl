table '06_fact_aereo_iata'

	column indicador
		dataType: string
		summarizeBy: none
		sourceColumn: indicador

	column periodo
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: periodo

	column valor
		dataType: double
		summarizeBy: sum
		sourceColumn: valor

	column unidad
		dataType: string
		summarizeBy: none
		sourceColumn: unidad

	column var_pct
		dataType: double
		summarizeBy: average
		sourceColumn: var_pct

	column fuente
		dataType: string
		summarizeBy: none
		sourceColumn: fuente

	column id_fuente
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: id_fuente

	measure 'Premium 2025 M' = CALCULATE(SUM('06_fact_aereo_iata'[valor]),'06_fact_aereo_iata'[indicador]="Premium intl")
		formatString: #,##0.0

	measure 'RPK Q2 2026 %' = MAX('06_fact_aereo_iata'[var_pct])/100
		formatString: 0.0%

	measure 'Pax 2026F M' = CALCULATE(SUM('06_fact_aereo_iata'[valor]),'06_fact_aereo_iata'[indicador]="Pax segmento",'06_fact_aereo_iata'[periodo]=2026)
		formatString: #,##0

	partition '06_fact_aereo_iata' = m
		mode: import
		source =
				let
				        Source = #table(
				            {"indicador","periodo","valor","unidad","var_pct","fuente","id_fuente"},
				            {
				      {"Pax segmento",2019,4560,"M",null,"IATA fact-sheet","IATA-26"},
				      {"Pax segmento",2024,4781,"M",null,"IATA fact-sheet","IATA-26"},
				      {"Pax segmento",2025,4967,"M E",null,"IATA fact-sheet","IATA-26"},
				      {"Pax segmento",2026,5085,"M F",null,"IATA fact-sheet","IATA-26"},
				      {"Premium intl",2025,109.7,"M",4.5,"IATA WATS 16/07/2026","IATA-26"},
				      {"RPK Q2",2026,-2.4,"% YoY",-2.4,"IATA Q2 Chartbook","IATA-26"},
				      {"RPK Jul total",2026,0.2,"% YoY",0.2,"IATA Jul 2026","IATA-26"},
				      {"RPK Jul intl",2026,-0.1,"% YoY",-0.1,"IATA Jul 2026","IATA-26"},
				      {"RPK Jul dom",2026,0.6,"% YoY",0.6,"IATA Jul 2026","IATA-26"},
				      {"ASK Ago",2026,0.3,"% YoY",0.3,"IATA Ago 2026","IATA-26"},
				      {"PLF Ago",2026,85.1,"%",-0.9,"IATA Ago 2026","IATA-26"},
				      {"RPK forecast",2026,4.9,"% YoY",4.9,"IATA Outlook dic-2025","IATA-26"}
				            }
				        ),
				        Typed = Table.TransformColumnTypes(Source, {{"indicador", type text},{"periodo", Int64.Type},{"valor", type number},{"unidad", type text},{"var_pct", type number},{"fuente", type text},{"id_fuente", type text}})
				    in
				        Typed

	annotation PBI_ResultType = Table
