{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "informe_llm",
  "description": "Informe LLM que el daily escribe y el front sirve. Contrato mínimo T4.",
  "type": "object",
  "required": ["corte", "secciones"],
  "properties": {
    "corte": {"type": "string", "description": "YYYY-MM-DD del corte"},
    "generado": {"type": "string"},
    "secciones": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "titulo", "bullets"],
        "properties": {
          "id": {"type": "string"},
          "titulo": {"type": "string"},
          "bullets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["texto", "fuente"],
              "properties": {
                "texto": {"type": "string"},
                "fuente": {"type": "string"}
              }
            }
          },
          "analisis": {"type": "array"},
          "grafico": {"type": "object"}
        }
      }
    }
  }
}
