From 40a4afaf400e63f0363e1b3aeb004209fbae03dc Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Tue, 3 Nov 2026 03:40:58 +0000
Subject: [PATCH] feat(ui): mostrar avisos, SISAIRE, BTS e IPC en el tablero
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

El calendario trae festivos de los emisores y los avisos de viaje. El clima suma el PM2.5 medido. Conectividad muestra sillas EE. UU.–Colombia y el IPC nacional. El refresco mensual de preparar_fuentes ya no borra las piezas del ETL del manifiesto.
---
 .github/workflows/fuentes-mensuales.yml |   27 +
 app.js                                  |   41 +-
 data/catalog.js                         |   18 +-
 data/open/bureau_calendario.json        | 1145 ++++++++++++++++++++++-
 data/open/bureau_clima.json             |   50 +-
 data/open/bureau_conectividad.json      |  545 ++++++++++-
 scripts/alimentar_bureau.py             |    5 +
 scripts/preparar_fuentes.py             |   12 +-
 8 files changed, 1818 insertions(+), 25 deletions(-)
 create mode 100644 .github/workflows/fuentes-mensuales.yml

diff --git a/.github/workflows/fuentes-mensuales.yml b/.github/workflows/fuentes-mensuales.yml
new file mode 100644
index 0000000..c28f02b
--- /dev/null
+++ b/.github/workflows/fuentes-mensuales.yml
@@ -0,0 +1,27 @@
+name: fuentes-mensuales
+on:
+  schedule:
+    - cron: "0 14 2 * *"  # día 2, 09:00 America/Bogota
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+jobs:
+  preparar:
+    runs-on: ubuntu-latest
+    timeout-minutes: 90
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - run: pip install openpyxl
+      - run: python scripts/preparar_fuentes.py
+      - name: publicar agregados
+        run: |
+          git config user.name tableros-etl
+          git config user.email tableros-etl@local
+          git add data/open
+          git diff --cached --quiet || git commit -m "data: fuentes mensuales $(date -u +%F)"
+          git push
